@page "/novo-quadro"
@rendermode InteractiveServer
@inject GaleriaService Servico
@inject NavigationManager Nav
@inject HttpClient Http

<h3>Adicionar Novo Quadro</h3>

<p>Título:</p>
<input @bind="novo.Titulo" style="width: 100%; padding: 8px;" placeholder="Ex: Ipê roxo" />

<p>Descrição:</p>
<input @bind="novo.Descricao" style="width: 100%; padding: 8px;" placeholder="Ex: Óleo sobre tela 50x70" />

<p>Preço:</p>
<input @bind="novo.Preco" style="width: 100%; padding: 8px;" placeholder="Ex: R$ 1.200,00" />

<p>Foto do quadro:</p>
<InputFile OnChange="EscolherFoto" accept="image/*"
           style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;" />

@if (!string.IsNullOrEmpty(novo.Imagem))
{
    <div style="margin-top: 15px;">
        <p>Prévia:</p>
        <img src="@novo.Imagem" style="max-width: 300px; border-radius: 8px; border: 1px solid #ddd;" />
    </div>
}

<br /><br />
<button class="btn-salvar" @onclick="Salvar" disabled="@enviando">
    @(enviando ? "Enviando foto..." : "Salvar quadro")
</button>

@if (mensagemErro != null)
{
    <p style="color:red">@mensagemErro</p>
}

@code {
    Quadro novo = new();
    byte[]? dadosFoto;
    string? nomeArquivo;
    string? mensagemErro;
    bool enviando = false;
    string? tipoFoto;

    async Task EscolherFoto(InputFileChangeEventArgs e)
    {
        try
        {
            mensagemErro = null;
            var arquivo = e.File;

            // Celular passa de 10MB fácil, subi pra 20MB
            if (arquivo.Size > 20 * 1024 * 1024)
            {
                mensagemErro = "Foto muito grande, tira uma foto menor ou escolhe outra.";
                return;
            }

            nomeArquivo = Guid.NewGuid().ToString() + Path.GetExtension(arquivo.Name);
            tipoFoto = arquivo.ContentType;

            using var ms = new MemoryStream();
            await arquivo.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            dadosFoto = ms.ToArray();

            novo.Imagem = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(dadosFoto)}";
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao ler foto: " + ex.Message;
            dadosFoto = null;
        }
    }

    async Task Salvar()
    {
        // TRAVA AQUI: se não tem foto, não deixa salvar quebrado
        if (dadosFoto == null)
        {
            mensagemErro = "Escolhe a foto de novo, ela não carregou.";
            return;
        }

        enviando = true;
        mensagemErro = null;
        StateHasChanged();

        try
        {
            using var conteudo = new MultipartFormDataContent();
            using var conteudoArquivo = new ByteArrayContent(dadosFoto);
            // Agora manda com o tipo real da foto, não fixo jpeg
            conteudoArquivo.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(tipoFoto ?? "image/jpeg");
            conteudo.Add(conteudoArquivo, "file", nomeArquivo);
            conteudo.Add(new StringContent("ml_padrao"), "upload_preset");

            var resposta = await Http.PostAsync(
                "https://api.cloudinary.com/v1_1/ivvoxil7/image/upload",
                conteudo);

            var json = await resposta.Content.ReadAsStringAsync();

            if (!resposta.IsSuccessStatusCode)
            {
                mensagemErro = "Erro ao subir foto: " + json;
                enviando = false;
                StateHasChanged();
                return;
            }

            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var url = doc.RootElement.GetProperty("secure_url").GetString();
            novo.Imagem = url;

            Servico.AdicionarQuadro(novo);
            Nav.NavigateTo("/galeria");
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro: " + ex.Message;
            enviando = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        if (!Servico.EstaLogado)
        {
            Nav.NavigateTo("/login");
        }
    }
}